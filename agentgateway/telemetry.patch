+#[tokio::test]
+async fn rejected_request_body_capture_respects_interest_and_limit() {
+	for (expression, limit, expected) in [
+		("request.body", 5, Some("hello")),
+		("request.body", 4, Some("")),
+		("request.method", 5, None),
+	] {
+		let exp = Expression::new_strict(expression).unwrap();
+		let mut cb = ContextBuilder::new();
+		cb.register_log_expression(&exp);
+		let mut req = ::http::Request::builder()
+			.method(Method::POST)
+			.uri("http://example.com")
+			.body(Body::from_stream(tokio_stream::iter([Ok::<
+				_,
+				std::convert::Infallible,
+			>("hello")])))
+			.unwrap();
+		req.extensions_mut().insert(crate::http::BufferLimit::new(limit));
+		cb.maybe_buffer_request_body(&mut req).await;
+		assert!(req.body().inspection().is_none());
+		cb.maybe_capture_failed_request_body(&mut req).await;
+		if limit == 4 {
+			assert!(matches!(
+				req.body().inspection(),
+				Some(crate::http::BodyInspection::Partial(bytes)) if bytes.as_ref() == b"hell"
+			));
+		}
+		if expression == "request.method" {
+			assert!(req.body().inspection().is_none());
+		} else {
+			let snapshot = cb.maybe_snapshot_request(&mut req, false).unwrap();
+			let exec = Executor::new_logger(Some(&snapshot), None, None, None, None, None, None);
+			if limit == 4 {
+				assert!(exec.eval(&Expression::new_strict("json(request.body)").unwrap()).is_err());
+			}
+			let captured = exec
+				.eval(&exp)
+				.ok()
+				.and_then(|value| helpers::value_as_byte_or_json(value).ok());
+			assert_eq!(captured.as_deref(), expected.map(str::as_bytes));
+		}
+	}
+}
+
