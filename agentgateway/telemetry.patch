+async fn rejected_request_capture_respects_route_deadline() {
+	let exp = Expression::new_strict("request.body").unwrap();
+	let mut cb = ContextBuilder::new();
+	cb.register_log_expression(&exp);
+	let mut req = ::http::Request::builder()
+		.body(Body::from_stream(tokio_stream::pending::<Result<String, std::convert::Infallible>>()))
+		.unwrap();
+	let deadline = tokio::time::Instant::now() + std::time::Duration::from_secs(1);
+	req.extensions_mut().insert(crate::http::filters::RequestDeadline(deadline.into_std()));
+	cb.maybe_capture_failed_request_body(&mut req).await;
+	assert_eq!(tokio::time::Instant::now(), deadline);
+	assert!(req.body().inspection().is_none());
+}
