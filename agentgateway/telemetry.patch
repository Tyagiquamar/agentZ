+#[test]
+fn generated_errors_preserve_typed_payload_and_wire_body() {
+	use rmcp::model::{ErrorCode, ErrorData, ServerJsonRpcMessage, ServerResult};
+
+	let errors = [
+		crate::mcp::Error::Authorization(RequestId::Number(1), "tool".into(), "denied".into()),
+		crate::mcp::Error::McpGuardrails {
+			request_id: RequestId::Number(2),
+			rej: ErrorData::new(
+				ErrorCode::INTERNAL_ERROR,
+				"guardrail failed",
+				Some(serde_json::json!({"nested": {"detail": "retained"}})),
+			),
+			was_tool_call: true,
+			downstream_modern: false,
+		},
+		crate::mcp::Error::RateLimited {
+			request_id: RequestId::Number(3),
+			status: Some(crate::http::localratelimit::RateLimitStatus {
+				limit: 5,
+				remaining: 0,
+				reset_seconds: 10,
+			}),
+			message: None,
+			headers: Box::default(),
+			was_tool_call: false,
+			downstream_modern: false,
+		},
+		crate::mcp::Error::RateLimited {
+			request_id: RequestId::Number(4),
+			status: None,
+			message: None,
+			headers: Box::default(),
+			was_tool_call: true,
+			downstream_modern: false,
+		},
+	];
+	for (index, error) in errors.into_iter().enumerate() {
+		let message = error.jsonrpc_error_message().unwrap();
+		let body: serde_json::Value =
+			serde_json::from_str(&error.jsonrpc_error_body().unwrap()).unwrap();
+		assert_eq!(serde_json::to_value(&message).unwrap(), body);
+		let mut info = crate::mcp::MCPInfo::default();
+		info.set_tool("target".into(), "tool".into());
+		match message {
+			ServerJsonRpcMessage::Error(error) => {
+				info.capture_error(&error.error);
+				assert_eq!(
+					info.tool.as_ref().unwrap().error.as_ref().unwrap(),
+					&body["error"]
+				);
+				if index == 1 {
+					assert_eq!(body["error"]["data"]["nested"]["detail"], "retained");
+				}
+				if index == 2 {
+					assert_eq!(body["error"]["data"]["retryAfterSeconds"], 10);
+				}
+			},
+			ServerJsonRpcMessage::Response(response) => {
+				let ServerResult::CallToolResult(result) = response.result else {
+					panic!("expected tool result")
+				};
+				info.capture_call_result(&result);
+				assert_eq!(
+					info.tool.as_ref().unwrap().result.as_ref().unwrap(),
+					&body["result"]
+				);
+				assert_eq!(body["result"]["isError"], true);
+			},
+			_ => panic!("expected terminal response"),
+		}
+	}
+}
