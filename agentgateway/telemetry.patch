+		for input in ["data: {}\n\n", "data: {}\n\ndata: [DONE]\n\n"] {
+			let events = Arc::new(Mutex::new(Vec::new()));
+			let captured = events.clone();
+			let body =
+				json_passthrough::<serde_json::Value>(Body::from(input.to_string()), 1024, move |event| {
+					captured.lock().unwrap().push(match event {
