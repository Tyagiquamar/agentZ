toJson(guardrails.map(g, {
	"phase": g.phase,
	"guard": g.guard,
	"action": g.action,
	"agentz": {
		"version": g.agentz.version,
		"eventId": g.agentz.eventId,
		"referenceId": g.agentz.referenceId,
		"policyId": g.agentz.policyId,
		"checkId": g.agentz.checkId,
		"revision": g.agentz.revision,
		"connectionId": g.agentz.connectionId,
		"attachment": g.agentz.attachment,
		"mandatory": g.agentz.mandatory,
		"scopes": g.agentz.scopes,
		"safeLabel": g.agentz.safeLabel,
		"explanation": g.agentz.explanation,
		"startedAt": g.agentz.startedAt,
		"retentionDays": g.agentz.retentionDays,
		"durationMs": g.agentz.durationMs,
		"sequence": g.agentz.sequence,
		"validationPass": has(g.agentz.validationPass) ? g.agentz.validationPass : null,
		"errorCode": has(g.agentz.errorCode) ? g.agentz.errorCode : null
	}
}))
