+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	#[test]
+	fn metadata_rejects_unknown_fields_and_incomplete_identity() {
+		assert!(serde_json::from_value::<Config>(serde_json::json!({
+			"version":1,"retentionDays":30,"request":[],"response":[],"capture":"off","delivery":"wholeOutput","typo":true
+		})).is_err());
+		let config: Config = serde_json::from_value(serde_json::json!({
+			"version":1,"retentionDays":30,"request":[],"response":[],"capture":"off","delivery":"wholeOutput"
+		})).unwrap();
+		assert!(config.validate_counts(1, 0).is_err());
+	}
+	#[tokio::test]
+	async fn mandatory_validation_blocks_later_mask_and_exports_safe_identity() {
+		use super::super::{Policy, TextRequest};
+		use crate::http::transformation_cel::TransformationMetadata;
+		use crate::telemetry::log::GuardrailLog;
+		use http_body_util::BodyExt as _;
+
+		let policy: Policy = serde_json::from_value(serde_json::json!({
+			"promptGuard":{"request":[
+				{"regex":{"action":"reject","rules":[{"pattern":"<masked>"}]}},
+				{"regex":{"action":"mask","rules":[{"pattern":"safe"}]}}
+			]}
+		}))
+		.unwrap();
+		let mut request = crate::http::Request::new(Body::from(""));
+		request.extensions_mut().insert(TransformationMetadata(serde_json::json!({
+			"agentz_guardrails": {
+				"version":1,"retentionDays":30,"capture":"off","delivery":"wholeOutput","response":[],
+				"request":[
+					{"policyId":"org-policy","checkId":"mandatory","scopes":["instructions","conversation"],"revision":"r1","connectionId":"","attachment":"organization","mandatory":true,"safeLabel":"Organization policy","safeExplanation":"Remove restricted content."},
+					{"policyId":"sandbox-policy","checkId":"mask","scopes":["instructions","conversation"],"revision":"r1","connectionId":"","attachment":"sandbox","mandatory":false,"safeLabel":"Redaction","safeExplanation":"Remove restricted content."}
+				]
+			}
+		}).as_object().unwrap().clone()));
+		let original = crate::cel::snapshot_request(&mut request, false);
+		let mut text = TextRequest {
+			content: "safe".to_string(),
+		};
+		let log = GuardrailLog::default();
+		let result = policy
+			.apply_prompt_guard(
+				&crate::test_helpers::policy_client(),
+				&mut text,
+				&::http::HeaderMap::new(),
+				None,
+				Some(&original),
+				Some(&log),
+			)
+			.await
+			.unwrap();
+		let (response, _) = result.expect("final mandatory check must block reintroduced content");
+		assert_eq!(response.status(), 422);
+		let body = response.into_body().collect().await.unwrap().to_bytes();
+		let body: serde_json::Value = serde_json::from_slice(&body).unwrap();
+		assert_eq!(body["error"]["guardrail"]["phase"], "input");
+		assert_eq!(body["error"]["code"], "guardrail_denied");
+		let entries = log.take().unwrap();
+		assert_eq!(entries.len(), 3);
+		let event = entries.last().unwrap().detail.agentz.as_ref().unwrap();
+		assert_eq!(event["policyId"], "org-policy");
+		assert_eq!(event["validationPass"], "mandatoryFinal");
+		assert_eq!(
+			event["referenceId"],
+			body["error"]["guardrail"]["referenceId"]
+		);
+		assert!(event.get("inspected").is_none());
+	}
+
+	#[test]
+	fn capture_is_opt_in_and_provider_reasons_are_removed() {
+		let check = Check {
+			policy_id: "policy".into(),
+			check_id: "check".into(),
+			scopes: vec!["conversation".into()],
+			revision: "r1".into(),
+			connection_id: String::new(),
+			attachment: "sandbox".into(),
+			mandatory: false,
+			safe_label: "Safe label".into(),
+			safe_explanation: "Edit the request.".into(),
+		};
+		for (capture, action, expected) in [
+			(Capture::Off, GuardrailAction::Reject, false),
+			(Capture::Findings, GuardrailAction::Allow, false),
+			(Capture::Findings, GuardrailAction::Reject, true),
+			(Capture::All, GuardrailAction::Allow, true),
+		] {
+			let evaluation =
+				Evaluation::new(&check, capture, 30, vec!["sensitive content".into()]).unwrap();
+			let mut detail = GuardDetail {
+				action_reason: Some("provider echoed sensitive content".into()),
+				..Default::default()
+			};
+			evaluation.finish(&mut detail, action, false, Vec::new());
+			assert!(detail.action_reason.is_none());
+			assert_eq!(detail.agentz.unwrap().get("inspected").is_some(), expected);
+		}
+	}
+}
