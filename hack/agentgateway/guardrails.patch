diff --git a/crates/agentgateway/src/llm/policy/agentz.rs b/crates/agentgateway/src/llm/policy/agentz.rs
new file mode 100644
index 00000000..10596a64
--- /dev/null
+++ b/crates/agentgateway/src/llm/policy/agentz.rs
@@ -0,0 +1,495 @@
+//! AgentZ's versioned extension carried by trusted transformation metadata.
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+use serde::{Deserialize, Serialize};
+
+use crate::cel::{GuardDetail, RequestSnapshot};
+use crate::http::{Body, Response};
+use crate::telemetry::metrics::{GuardrailAction, GuardrailPhase};
+
+const UNSUPPORTED_CONTENT_EXPLANATION: &str =
+	"These guardrails support text only. Remove attachments or request text output, then try again.";
+
+#[derive(Clone, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Config {
+	pub version: u32,
+	pub retention_days: u32,
+	pub request: Vec<Check>,
+	pub response: Vec<Check>,
+	pub capture: Capture,
+	pub delivery: Delivery,
+}
+
+#[derive(Clone, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Check {
+	pub policy_id: String,
+	pub check_id: String,
+	pub scopes: Vec<String>,
+	pub revision: String,
+	pub connection_id: String,
+	pub attachment: String,
+	pub mandatory: bool,
+	pub safe_label: String,
+	pub safe_explanation: String,
+}
+
+#[derive(Clone, Copy, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub enum Capture {
+	Off,
+	Findings,
+	All,
+}
+
+#[derive(Clone, Copy, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub enum Delivery {
+	CheckedStreaming,
+	WholeOutput,
+}
+
+impl Config {
+	pub fn from_snapshot(snapshot: Option<&RequestSnapshot>) -> anyhow::Result<Option<Self>> {
+		let Some(value) = snapshot
+			.and_then(|s| s.metadata.as_ref())
+			.and_then(|m| m.0.get("agentz_guardrails"))
+		else {
+			return Ok(None);
+		};
+		let config: Self = serde_json::from_value(value.clone())?;
+		anyhow::ensure!(
+			config.version == 1,
+			"unsupported AgentZ guardrail metadata version"
+		);
+		anyhow::ensure!(
+			(1..=3650).contains(&config.retention_days),
+			"invalid AgentZ guardrail retention"
+		);
+		for check in config.request.iter().chain(&config.response) {
+			anyhow::ensure!(
+				!check.scopes.is_empty()
+					&& check.scopes.iter().all(|s| matches!(
+						s.as_str(),
+						"instructions" | "conversation" | "toolResults" | "toolArguments"
+					)),
+				"invalid AgentZ content scope"
+			);
+			anyhow::ensure!(
+				!check.policy_id.is_empty() && !check.check_id.is_empty() && !check.revision.is_empty(),
+				"AgentZ guardrail identity is incomplete"
+			);
+		}
+		Ok(Some(config))
+	}
+
+	pub fn validate_counts(&self, request: usize, response: usize) -> anyhow::Result<()> {
+		anyhow::ensure!(
+			self.request.len() == request && self.response.len() == response,
+			"AgentZ guardrail metadata does not match the effective check chain"
+		);
+		Ok(())
+	}
+}
+
+/// Validate known protocol content containers before their text-only projections are created.
+/// Tool argument objects are deliberately not traversed as message/media descriptors.
+pub fn validate_text_content(value: &serde_json::Value) -> anyhow::Result<()> {
+	let mut pending = vec![value];
+	while let Some(value) = pending.pop() {
+		if let Some(items) = value.as_array() {
+			pending.extend(items);
+			continue;
+		}
+		let Some(object) = value.as_object() else {
+			continue;
+		};
+		let kind = object
+			.get("type")
+			.and_then(serde_json::Value::as_str)
+			.unwrap_or_default();
+		anyhow::ensure!(
+			!matches!(
+				kind,
+				"image"
+					| "image_url"
+					| "input_image"
+					| "input_audio"
+					| "audio"
+					| "file"
+					| "input_file"
+					| "document"
+					| "video"
+					| "image_generation_call"
+					| "response.audio.delta"
+					| "response.output_audio.delta"
+			),
+			"guardrail policy does not support this content modality"
+		);
+		anyhow::ensure!(
+			![
+				"audio",
+				"image_url",
+				"input_audio",
+				"inlineData",
+				"inline_data",
+				"fileData",
+				"file_data"
+			]
+			.iter()
+			.any(|key| object.contains_key(*key)),
+			"guardrail policy does not support embedded media"
+		);
+		if let Some(modalities) = object
+			.get("modalities")
+			.and_then(serde_json::Value::as_array)
+		{
+			anyhow::ensure!(
+				modalities.iter().all(|v| v.as_str() == Some("text")),
+				"guardrail policy requires text-only output"
+			);
+		}
+		for key in [
+			"messages",
+			"input",
+			"output",
+			"content",
+			"contents",
+			"candidates",
+			"parts",
+			"systemInstruction",
+			"system_instruction",
+			"choices",
+			"message",
+			"delta",
+			"response",
+			"item",
+			"content_block",
+		] {
+			if key == "input" && matches!(kind, "tool_use" | "function_call" | "custom_tool_call") {
+				continue;
+			}
+			if let Some(child) = object.get(key) {
+				pending.push(child);
+			}
+		}
+	}
+	Ok(())
+}
+
+impl Config {
+	/// Promote only a locally recorded terminal verdict, never provider-authored error JSON.
+	pub fn promote_stream_error(
+		&self,
+		bytes: &[u8],
+		log: &crate::telemetry::log::GuardrailLog,
+	) -> Option<Response> {
+		let data = std::str::from_utf8(bytes)
+			.ok()?
+			.lines()
+			.find_map(|line| line.strip_prefix("data: "))?;
+		let envelope: serde_json::Value = serde_json::from_str(data).ok()?;
+		let reference = envelope
+			.get("error")?
+			.get("guardrail")?
+			.get("referenceId")?
+			.as_str()?;
+		let mut recorded = None;
+		log.non_atomic_mutate(|entries| {
+			for entry in entries.iter().rev() {
+				let Some(event) = entry.detail.agentz.as_ref() else {
+					continue;
+				};
+				if entry.action != "reject"
+					|| event.get("referenceId").and_then(serde_json::Value::as_str) != Some(reference)
+				{
+					continue;
+				}
+				if let (Some(policy_id), Some(check_id)) = (
+					event.get("policyId").and_then(serde_json::Value::as_str),
+					event.get("checkId").and_then(serde_json::Value::as_str),
+				) {
+					recorded = Some((
+						policy_id.to_owned(),
+						check_id.to_owned(),
+						event.get("errorCode").is_some(),
+						event.get("errorCode").and_then(serde_json::Value::as_str)
+							== Some("unsupported_content"),
+					));
+				}
+				break;
+			}
+		});
+		let (policy_id, check_id, unavailable, unsupported_content) = recorded?;
+		let check = self
+			.response
+			.iter()
+			.find(|c| c.policy_id == policy_id && c.check_id == check_id)?;
+		let mut evaluation =
+			Evaluation::new(check, Capture::Off, self.retention_days, Vec::new()).ok()?;
+		evaluation.reference_id = reference.to_string();
+		evaluation.unsupported_content = unsupported_content;
+		Some(evaluation.response(GuardrailPhase::Response, unavailable, false))
+	}
+
+	pub fn reject_content(
+		&self,
+		phase: GuardrailPhase,
+		log: Option<&crate::telemetry::log::GuardrailLog>,
+	) -> anyhow::Result<Response> {
+		let check = if phase == GuardrailPhase::Request {
+			self.request.first().or_else(|| self.response.first())
+		} else {
+			self.response.first().or_else(|| self.request.first())
+		};
+		let check = check.ok_or_else(|| anyhow::anyhow!("no AgentZ checks configured"))?;
+		let mut evaluation = Evaluation::new(check, Capture::Off, self.retention_days, Vec::new())?;
+		evaluation.unsupported_content = true;
+		let response = evaluation.response(phase, true, false);
+		let mut detail = GuardDetail::default();
+		evaluation.finish(&mut detail, GuardrailAction::Reject, true, Vec::new());
+		if let Some(event) = detail.agentz.as_mut() {
+			event["errorCode"] = "unsupported_content".into();
+		}
+		super::record_guardrail(
+			log,
+			phase,
+			"capability",
+			GuardrailAction::Reject,
+			Some(detail),
+		);
+		Ok(response)
+	}
+}
+
+pub struct Evaluation {
+	check: Check,
+	capture: Capture,
+	started: Instant,
+	started_at: u64,
+	retention_days: u32,
+	pub reference_id: String,
+	pub capture_limited: bool,
+	pub unsupported_content: bool,
+	inspected: Option<Vec<String>>,
+}
+
+impl Evaluation {
+	pub fn new(
+		check: &Check,
+		capture: Capture,
+		retention_days: u32,
+		inspected: Vec<String>,
+	) -> anyhow::Result<Self> {
+		// Do not call the checker with content we cannot retain under full capture.
+		let capture_limited =
+			capture != Capture::Off && inspected.iter().map(String::len).sum::<usize>() > 1024 * 1024;
+		let capture = if capture_limited {
+			Capture::Off
+		} else {
+			capture
+		};
+
+		Ok(Self {
+			check: check.clone(),
+			capture_limited,
+			unsupported_content: false,
+			capture,
+			retention_days,
+			started: Instant::now(),
+			started_at: SystemTime::now().duration_since(UNIX_EPOCH)?.as_millis() as u64,
+			reference_id: uuid::Uuid::new_v4().to_string(),
+			inspected: (capture != Capture::Off).then_some(inspected),
+		})
+	}
+
+	pub fn response(&self, phase: GuardrailPhase, unavailable: bool, partial: bool) -> Response {
+		let code = if unavailable {
+			"guardrail_unavailable"
+		} else {
+			"guardrail_denied"
+		};
+		let explanation = if unavailable {
+			if self.unsupported_content {
+				UNSUPPORTED_CONTENT_EXPLANATION
+			} else {
+				"A required guardrail could not complete. Try again later."
+			}
+			.to_string()
+		} else {
+			self.check.safe_explanation.clone()
+		};
+		let body = serde_json::json!({
+			"error": {
+				"type": code,
+				"code": code,
+				"message": explanation,
+				"guardrail": {
+					"code": code,
+					"phase": if phase == GuardrailPhase::Request { "input" } else { "output" },
+					"safeLabel": self.check.safe_label,
+					"explanation": explanation,
+					"referenceId": self.reference_id,
+					"partialOutput": partial,
+				}
+			}
+		});
+		::http::Response::builder()
+			.extension(crate::proxy::GuardrailOutcome)
+			.status(if unavailable { 503 } else { 422 })
+			.header(::http::header::CONTENT_TYPE, "application/json")
+			.header("x-agentz-guardrail-outcome", "1")
+			.body(Body::from(body.to_string()))
+			.expect("static AgentZ guardrail response")
+	}
+
+	pub fn finish(
+		self,
+		detail: &mut GuardDetail,
+		action: GuardrailAction,
+		error: bool,
+		replacement: Vec<String>,
+	) {
+		// Provider reasons are untrusted free text. Only configured safe feedback leaves the checker boundary.
+		detail.action_reason = None;
+		let capture = self.capture == Capture::All || action != GuardrailAction::Allow || error;
+		let mut event = serde_json::json!({
+			"version": 1,
+			"eventId": self.reference_id,
+			"referenceId": self.reference_id,
+			"policyId": self.check.policy_id,
+			"checkId": self.check.check_id,
+			"scopes": self.check.scopes,
+			"revision": self.check.revision,
+			"connectionId": self.check.connection_id,
+			"attachment": self.check.attachment,
+			"mandatory": self.check.mandatory,
+			"safeLabel": self.check.safe_label,
+			"explanation": if self.unsupported_content { UNSUPPORTED_CONTENT_EXPLANATION } else { self.check.safe_explanation.as_str() },
+			"startedAt": self.started_at,
+			"retentionDays": self.retention_days,
+			"durationMs": self.started.elapsed().as_secs_f64() * 1000.0,
+		});
+		if error {
+			event["errorCode"] = if self.unsupported_content {
+				"unsupported_content".into()
+			} else if self.capture_limited {
+				"capture_limit".into()
+			} else {
+				"checker_error".into()
+			};
+		}
+		if capture && let Some(inspected) = self.inspected {
+			event["inspected"] = serde_json::json!(inspected);
+			if action == GuardrailAction::Mask {
+				event["replacement"] = serde_json::json!(replacement);
+			}
+		}
+		detail.agentz = Some(event);
+	}
+}
